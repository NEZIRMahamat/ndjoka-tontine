# Domaine du tenant Auth0, sans protocole ni barre finale.
AUTH0_DOMAIN=your-tenant.eu.auth0.com

# Identifier exact de la Custom API Auth0.
AUTH0_AUDIENCE=https://api.ndjoka-tontine.com

# Origines frontend autorisées, au format JSON attendu par pydantic-settings.
# Remplacer l'origine personnalisée si le domaine public du frontend change.
CORS_ALLOWED_ORIGINS=["http://localhost:5173","https://app.ndjoka-tontine.com"]

# URL SQLAlchemy asynchrone vers PostgreSQL local.
# Sur Render, configurer l'Internal Database URL dans le Web Service.
# L'External Database URL et son paramètre sslmode sont acceptés pour une
# migration ponctuelle depuis le poste local. Encoder les caractères spéciaux
# du mot de passe dans une URL réelle.
DATABASE_URL=postgresql+asyncpg://ndjoka_postgres_admin:change-me-for-local-development@127.0.0.1:5433/ndjoka_db

# Aucun Client Secret n'est requis pour valider un Access Token RS256.
